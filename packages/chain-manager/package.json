{
  "name": "@leofcoin/chain-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Leofcoin operator console and genesis studio for web and desktop",
  "author": "Leofcoin",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "serve": "node server.js",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "npm run build -w @leofcoin/endpoints && npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "genesis:extract": "node scripts/extract-genesis.js"
  },
  "devDependencies": {
    "@leofcoin/lib": "^1.3.15",
    "@leofcoin/messages": "^1.6.5",
    "@leofcoin/multi-wallet": "^3.1.11",
    "@leofcoin/utils": "^1.1.45",
    "buffer": "^6.0.3",
    "@noble/hashes": "^2.2.0",
    "lit": "^3.3.3",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "org.leofcoin.chain-manager",
    "productName": "Leofcoin Chain Manager",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "mac": { "category": "public.app-category.developer-tools" }
  }
}
