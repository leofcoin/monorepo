{
  "name": "@leofcoin/chain",
  "version": "1.10.10",
  "description": "Official javascript implementation",
  "private": false,
  "exports": {
    "./node": {
      "import": "./exports/node.js",
      "types": "./exports/node.d.ts"
    },
    "./chain": {
      "import": "./exports/chain.js",
      "types": "./exports/chain.d.ts"
    },
    "./consensus/beacon": {
      "import": "./exports/beacon.js",
      "types": "./types/beacon.d.ts"
    },
    "./consensus/beacon-wire": {
      "import": "./exports/beacon-wire.js",
      "types": "./types/beacon-wire.d.ts"
    },
    "./consensus/beacon-envelope": {
      "import": "./exports/beacon-envelope.js",
      "types": "./types/beacon-envelope.d.ts"
    },
    "./consensus/beacon-epoch": {
      "import": "./exports/beacon-epoch.js",
      "types": "./types/beacon-epoch.d.ts"
    },
    "./consensus/beacon-round": {
      "import": "./exports/beacon-round.js",
      "types": "./types/beacon-round.d.ts"
    },
    "./consensus/beacon-lifecycle": {
      "import": "./exports/beacon-lifecycle.js",
      "types": "./types/beacon-lifecycle.d.ts"
    },
    "./browser/node": {
      "import": "./exports/browser/node.js",
      "types": "./exports/node.d.ts"
    },
    "./browser/chain": {
      "import": "./exports/browser/chain.js",
      "types": "./exports/chain.d.ts"
    },
    "./workers/machine-worker": "./exports/workers/machine-worker.js"
  },
  "type": "module",
  "files": [
    "./exports",
    "./types",
    "LICENSE.txt"
  ],
  "scripts": {
    "np": "np",
    "watch": "rollup -c -w --silent error --cache true",
    "prettier": "prettier src --config ./../../.prettierrc --write",
    "w": "rollup -c -w",
    "docs": "sh ./node_modules/.bin/esdoc src/chain.js",
    "workers": "cp ./../workers/src/** ./workers",
    "demo": "jsproject --serve ./ --port 5478 --open demo",
    "test": "node --test test/operational.test.js test/unit/*.test.js",
    "pack": "webpack",
    "build": "rollup -c --silent error",
    "npm-check-updates": "npx npm-check-updates -u --install always"
  },
  "np": {
    "yarn": false,
    "contents": "."
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/semver": "^7.8.0",
    "@vandeurenglenn/debug": "^1.4.0",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-modify": "^3.0.0",
    "tape": "^5.10.2",
    "tslib": "^2.8.1"
  },
  "dependencies": {
    "@noble/curves": "^1.2.0",
    "@noble/hashes": "^1.3.2",
    "@leofcoin/addresses": "^1.0.60",
    "@leofcoin/codecs": "^1.1.4",
    "@leofcoin/contracts": "^0.1.21",
    "@leofcoin/crypto": "^0.2.41",
    "@leofcoin/errors": "^1.0.30",
    "@leofcoin/lib": "^1.3.4",
    "@leofcoin/messages": "^1.6.1",
    "@leofcoin/multi-wallet": "^3.1.9",
    "@leofcoin/networks": "^1.1.30",
    "@leofcoin/peernet": "^1.2.28",
    "@leofcoin/storage": "^3.5.38",
    "@leofcoin/utils": "^1.1.45",
    "@leofcoin/workers": "^1.5.34",
    "@vandeurenglenn/base58": "^1.1.9",
    "@vandeurenglenn/easy-worker": "^1.0.3",
    "@vandeurenglenn/typed-array-utils": "^1.2.0",
    "semver": "^7.8.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leofcoin/monorepo"
  }
}
