{
  "name": "@leofcoin/chain",
  "version": "1.9.24",
  "description": "Official javascript implementation",
  "private": false,
  "exports": {
    "./node": {
      "import": "./exports/node.js",
      "types": "./exports/node.d.ts"
    },
    "./chain": {
      "import": "./exports/chain.js",
      "types": "./exports/chain.d.ts"
    },
    "./browser/node": {
      "import": "./exports/browser/node.js",
      "types": "./exports/node.d.ts"
    },
    "./browser/chain": {
      "import": "./exports/browser/chain.js",
      "types": "./exports/chain.d.ts"
    },
    "./workers/machine-worker": "./exports/workers/machine-worker.js"
  },
  "type": "module",
  "files": [
    "./exports",
    "LICENSE.txt"
  ],
  "scripts": {
    "np": "np",
    "watch": "rollup -c -w --silent error --cache true",
    "prettier": "prettier src --config ./../../.prettierrc --write",
    "w": "rollup -c -w",
    "docs": "sh ./node_modules/.bin/esdoc src/chain.js",
    "workers": "cp ./../workers/src/** ./workers",
    "demo": "jsproject --serve ./ --port 5478 --open demo",
    "test": "node --test test/operational.test.js",
    "pack": "webpack",
    "build": "rollup -c --silent error",
    "npm-check-updates": "npx npm-check-updates -u --install always"
  },
  "np": {
    "yarn": false,
    "contents": "."
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/semver": "^7.7.1",
    "@vandeurenglenn/debug": "^1.4.0",
    "rollup": "^4.61.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-modify": "^3.0.0",
    "tape": "^5.9.0",
    "tslib": "^2.8.1"
  },
  "dependencies": {
    "@leofcoin/addresses": "^1.0.58",
    "@leofcoin/codecs": "^1.1.3",
    "@leofcoin/contracts": "^0.1.19",
    "@leofcoin/crypto": "^0.2.39",
    "@leofcoin/errors": "^1.0.28",
    "@leofcoin/lib": "^1.2.78",
    "@leofcoin/messages": "^1.5.3",
    "@leofcoin/multi-wallet": "^3.1.9",
    "@leofcoin/networks": "^1.1.28",
    "@leofcoin/peernet": "^1.2.21",
    "@leofcoin/storage": "^3.5.38",
    "@leofcoin/utils": "^1.1.42",
    "@leofcoin/workers": "^1.5.31",
    "@vandeurenglenn/base58": "^1.1.9",
    "@vandeurenglenn/easy-worker": "^1.0.3",
    "@vandeurenglenn/typed-array-utils": "^1.2.0",
    "semver": "^7.8.2"
  }
}
