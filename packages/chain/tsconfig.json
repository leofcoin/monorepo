{
    "compilerOptions": {
      "module": "NodeNext",
      "target": "ES2022",
      "outDir": "./exports",
      "rootDir": "./src",
      "moduleResolution":"NodeNext",
      "declaration": true,
      "emitDeclarationOnly": true,
      "declarationDir": "./exports",
      "allowSyntheticDefaultImports": true,    
      "resolveJsonModule": true,
      "useDefineForClassFields": false,
      "types": [
        "node"
      ]
    },
  "include": [
    "./src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}