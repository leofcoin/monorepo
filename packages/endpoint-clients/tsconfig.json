{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "es2022",
    "rootDir": "./src",
    "outDir": "./exports",
    "moduleResolution":"NodeNext",
    "allowJs": true,
    "declaration": true,
    "declarationDir": "./exports/types",
    "allowSyntheticDefaultImports": true,    
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noImplicitAny": false,
    "strictPropertyInitialization": false
  },
  "include": [
    "./src/**/*"
  ]
}
