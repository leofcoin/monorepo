{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ESNext",
    "moduleResolution": "NodeNext",
    "outDir": "./exports",
    "declaration": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["src/*.ts"],
  "exclude": ["node_modules"]
}
