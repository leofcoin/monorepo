{
  "name": "@leofcoin/workers",
  "version": "1.6.0",
  "description": "Workers used in @leofcoin/chain",
  "type": "module",
  "private": false,
  "exports": {
    "./binary-worker": {
      "import": "./exports/binary-worker.js",
      "types": "./exports/binary-worker.d.ts"
    },
    "./machine-worker": {
      "import": "./exports/machine-worker.js",
      "types": "./exports/machine-worker.d.ts"
    },
    "./execution-meter": {
      "import": "./exports/execution-meter.js",
      "types": "./exports/execution-meter.d.ts"
    },
    "./deterministic-crypto": {
      "import": "./exports/deterministic-crypto.js",
      "types": "./exports/deterministic-crypto.d.ts"
    },
    "./block-worker": "./exports/block-worker.js",
    "./transaction-worker": "./src/transaction-worker.js",
    "./pool-worker": "./src/pool-worker.js"
  },
  "files": [
    "exports",
    "src/**/*.js"
  ],
  "scripts": {
    "prettier": "prettier src --config ./../../.prettierrc --write",
    "test": "node --test",
    "npm-check-updates": "npx npm-check-updates -u --install always",
    "build": "rollup -c --silent error --cache true"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@leofcoin/binary": "^1.1.0",
    "@noble/hashes": "^2.4.0",
    "acorn": "^8.19.0",
    "@leofcoin/addresses": "^1.1.0",
    "@leofcoin/lib": "^1.4.0",
    "@leofcoin/messages": "^2.0.0",
    "@leofcoin/storage": "^3.5.38",
    "@leofcoin/utils": "^1.1.45",
    "@vandeurenglenn/easy-worker": "^1.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leofcoin/monorepo"
  }
}
