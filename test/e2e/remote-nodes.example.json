      "transactionCommand": "leofcoin-staging-transaction"
    },
    {
      "name": "validator-2",
      "host": "leofcoin-validator-2",
      "service": "leofcoin",
      "healthCommand": "curl --fail --silent http://127.0.0.1:8080/ready",
      "stateCommand": "curl --fail --silent http://127.0.0.1:8080/chain/tip"
    },
    {
      "name": "validator-3",
      "host": "leofcoin-validator-3",
      "service": "leofcoin",
      "healthCommand": "curl --fail --silent http://127.0.0.1:8080/ready",
      "stateCommand": "curl --fail --silent http://127.0.0.1:8080/chain/tip"
    }
  ]
